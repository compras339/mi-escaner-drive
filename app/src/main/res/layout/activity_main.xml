<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Imagen de fondo opcional según la marca (p. ej. brasas) -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Fondo"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:ignore="HardcodedText" />

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/contentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <!-- Título (se ajusta al ancho en una sola línea) -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="Escáner de Compras"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        app:autoSizeMaxTextSize="28sp"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Logo de la marca (cambia según el tema) -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_alimentos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:ignore="HardcodedText" />

    <!-- Estado -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="14dp"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        tools:ignore="HardcodedText" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        tools:visibility="visible" />

    <!-- Botones de sede (se generan en código según la marca y los permisos) -->
    <ScrollView
        android:id="@+id/scrollSedes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnGallery"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/layoutSedes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Galería (solo con sesión iniciada) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGallery"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Ver galería de escaneos"
        android:visibility="gone"
        app:icon="@android:drawable/ic_menu_gallery"
        app:layout_constraintBottom_toTopOf="@id/btnSignIn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText"
        tools:visibility="visible" />

    <!-- Cuenta -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSignIn"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Vincular cuenta de Google"
        app:layout_constraintBottom_toTopOf="@id/tvCredit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Crédito discreto -->
    <TextView
        android:id="@+id/tvCredit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.55"
        android:text="Creado por Jessica Flores"
        android:textAlignment="center"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText,SmallSp" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== Pantalla de espera / inicio de sesión (sin sesión o cargando permisos) ===== -->
    <LinearLayout
        android:id="@+id/welcomeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#16212E"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvWelcomeKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.25"
            android:text="ESCÁNER DE COMPRAS"
            android:textColor="#F5A524"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/ivWelcomeLogo"
            android:layout_width="210dp"
            android:layout_height="112dp"
            android:layout_marginTop="14dp"
            android:contentDescription="Alimentos Express"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_alimentos_light"
            tools:ignore="HardcodedText" />

        <!-- Chef animado (SVG + CSS en assets/chef.html) -->
        <WebView
            android:id="@+id/webChef"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvWelcomeHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calentando la sartén..."
            android:textColor="#F4F1EA"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="Vincula tu cuenta de Google para empezar a escanear tus compras."
            android:textColor="#B7C2CE"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <!-- Barra de carga -->
        <FrameLayout
            android:id="@+id/loadingTrack"
            android:layout_width="140dp"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_loading_track"
            android:clipChildren="true">

            <View
                android:id="@+id/loadingBar"
                android:layout_width="56dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_loading_bar" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcomeSignIn"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#FFFFFF"
            android:text="Vincular cuenta de Google"
            android:textAllCaps="false"
            android:textColor="#16212E"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:rippleColor="#DCE4EE"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Creado por Jessica Flores"
            android:textColor="#8C9AAA"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</FrameLayout>
