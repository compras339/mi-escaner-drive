<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EscanerDrive" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#122235</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#DCE4EE</item>
        <item name="colorOnSecondaryContainer">#122235</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Android 15+: no dibujar debajo de la barra de estado ni de navegación -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">#122235</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
